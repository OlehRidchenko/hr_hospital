<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="disease_report_wizard_view_form" model="ir.ui.view">
        <field name="name">disease.report.wizard.form</field>
        <field name="model">disease.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Disease Report">
                <group>
                    <group string="Filters">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="doctor_ids" widget="many2many_tags"/>
                        <field name="disease_ids" widget="many2many_tags"/>
                        <field name="country_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Report Settings">
                        <field name="report_type"/>
                        <field name="group_by"/>
                        <field name="result_count" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_generate_report"
                        string="Generate Report"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="medical_diagnosis_view_search" model="ir.ui.view">
        <field name="name">medical.diagnosis.search</field>
        <field name="model">medical.diagnosis</field>
        <field name="arch" type="xml">
            <search string="Search Diagnoses">
                <field name="disease_id"/>
                <field name="visit_id"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>

                <filter name="filter_approved"
                        string="Approved"
                        domain="[('is_approved', '=', True)]"/>
                <filter name="filter_not_approved"
                        string="Not Approved"
                        domain="[('is_approved', '=', False)]"/>
                <separator/>
                <filter name="filter_critical"
                        string="Critical"
                        domain="[('severity', '=', 'critical')]"/>
                <filter name="filter_severe"
                        string="Severe"
                        domain="[('severity', '=', 'severe')]"/>
                <separator/>

                <filter name="search_default_disease_id"
                        string="Group by Disease"
                        context="{'group_by': 'disease_id'}"/>
                <filter name="search_default_severity"
                        string="Group by Severity"
                        context="{'group_by': 'severity'}"/>
                <filter name="search_default_is_approved"
                        string="Group by Approval"
                        context="{'group_by': 'is_approved'}"/>
                <filter name="search_default_doctor_id"
                        string="Group by Doctor"
                        context="{'group_by': 'doctor_id'}"/>

                <group expand="0" string="Group By">
                    <filter name="group_disease"
                            string="By Disease"
                            context="{'group_by': 'disease_id'}"/>
                    <filter name="group_severity"
                            string="By Severity"
                            context="{'group_by': 'severity'}"/>
                    <filter name="group_approved"
                            string="By Approval"
                            context="{'group_by': 'is_approved'}"/>
                    <filter name="group_doctor"
                            string="By Doctor"
                            context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_patient"
                            string="By Patient"
                            context="{'group_by': 'patient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="disease_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Disease Report</field>
        <field name="res_model">disease.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

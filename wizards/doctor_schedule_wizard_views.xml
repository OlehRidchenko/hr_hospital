<odoo>
    <record id="doctor_schedule_wizard_view_form" model="ir.ui.view">
        <field name="name">doctor.schedule.wizard.form</field>
        <field name="model">doctor.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Doctor Schedule">
                <group>
                    <group string="Doctor &amp; Period">
                        <field name="doctor_id"/>
                        <field name="week_start"/>
                        <field name="weeks_count"/>
                        <field name="schedule_type"/>
                    </group>
                    <group string="Working Hours">
                        <field name="time_start" widget="float_time"/>
                        <field name="time_end" widget="float_time"/>
                        <field name="break_start" widget="float_time"/>
                        <field name="break_end" widget="float_time"/>
                    </group>
                </group>
                <group string="Working Days">
                    <group>
                        <field name="mon"/>
                        <field name="tue"/>
                        <field name="wed"/>
                        <field name="thu"/>
                    </group>
                    <group>
                        <field name="fri"/>
                        <field name="sat"/>
                        <field name="sun"/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_generate_schedule"
                        string="Generate Schedule"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="doctor_schedule_wizard_action" model="ir.actions.act_window">
        <field name="name">Generate Schedule</field>
        <field name="res_model">doctor.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_view_types">form,tree</field>
    </record>
</odoo>

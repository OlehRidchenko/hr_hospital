<odoo>
     <record id="medical_diagnosis_view_tree" model="ir.ui.view">
        <field name="name">medical.diagnosis.tree</field>
        <field name="model">medical.diagnosis</field>
        <field name="arch" type="xml">
            <tree>
                <field name="visit_id"/>
                <field name="disease_id"/>
                <field name="severity"/>
                <field name="is_approved"/>
                <field name="approved_doctor_id"/>
                <field name="approval_datetime"/>
            </tree>
        </field>
    </record>

    <record id="medical_diagnosis_view_form" model="ir.ui.view">
        <field name="name">medical.diagnosis.form</field>
        <field name="model">medical.diagnosis</field>
        <field name="arch" type="xml">
            <form string="Medical Diagnosis">
                <group>
                    <group>
                        <field name="visit_id"/>
                        <field name="disease_id"/>
                        <field name="severity"/>
                    </group>
                    <group>
                        <field name="is_approved"/>
                        <field name="approved_doctor_id"/>
                        <field name="approval_datetime"/>
                    </group>
                </group>
                <notebook>
                    <page string="Description">
                        <field name="description"/>
                    </page>
                    <page string="Treatment">
                        <field name="treatment"/>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

       <record id="visit_view_pivot" model="ir.ui.view">
        <field name="name">medical.diagnosis.pivot</field>
        <field name="model">medical.diagnosis</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="disease_id" type="row"/>
                <field name="approval_datetime" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="visit_view_graph" model="ir.ui.view">
        <field name="name">medical.diagnosis.graph</field>
        <field name="model">medical.diagnosis</field>
        <field name="arch" type="xml">
            <graph string="Diagnosis graph" stacked="0">
                <field name="disease_id"/>
                <field name="approval_datetime"/>
            </graph>
        </field>
    </record>

    <record id="medical_diagnosis_action" model="ir.actions.act_window">
        <field name="name">Diagnoses</field>
        <field name="res_model">medical.diagnosis</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>
</odoo>
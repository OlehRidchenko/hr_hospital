<odoo>
    <record id="disease_view_tree" model="ir.ui.view">
        <field name="name">disease.tree</field>
        <field name="model">hr_hospital.disease</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="icd10_code"/>
                <field name="danger_level"/>
                <field name="is_contagious"/>
            </tree>
        </field>
    </record>

    <record id="disease_view_form" model="ir.ui.view">
        <field name="name">disease.form</field>
        <field name="model">hr_hospital.disease</field>
        <field name="arch" type="xml">
            <form string="Disease">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="icd10_code"/>
                        <field name="danger_level"/>
                        <field name="is_contagious"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="symptoms"/>
                        <field name="country_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Sub-diseases">
                            <field name="child_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="icd10_code"/>
                                    <field name="danger_level"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="disease_view_search" model="ir.ui.view">
        <field name="name">disease.search</field>
        <field name="model">hr_hospital.disease</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                    <field name="parent_id"
                           string="Disease Category"
                           hierarchize="1"
                           enable_counters="1"/>
                    <field name="danger_level"
                           string="Danger Level"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="disease_action" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="res_model">hr_hospital.disease</field>
        <field name="view_mode">tree,form,search</field>
    </record>
</odoo>

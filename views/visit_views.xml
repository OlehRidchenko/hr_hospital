<odoo>
    <record id="visit_view_tree" model="ir.ui.view">
        <field name="name">visit.tree</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="status"/>
                <field name="planned_datetime"/>
                <field name="actual_datetime"/>
                <field name="visit_type"/>
                <field name="diagnosis_ids"/>
                <field name="recommendations"/>
                <field name="currency_id"/>
                <field name="cost"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <record id="visit_view_form" model="ir.ui.view">
        <field name="name">visit.form</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="status"/>
                        <field name="planned_datetime"/>
                        <field name="actual_datetime"/>
                        <field name="visit_type"/>
                        <field name="diagnosis_ids"/>
                        <field name="recommendations"/>
                        <field name="currency_id"/>
                        <field name="cost"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hr_hospital.visit</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

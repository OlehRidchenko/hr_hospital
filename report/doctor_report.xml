<odoo>
    <template id="report_doctor_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>
                                <t t-esc="doc.name"/>
                            </h2>
                            <h4 class="text-muted">
                                <t t-esc="doc.speciality_id.name or ''"/>
                            </h4>
                        </div>

                        <h5 class="mt-4">Visit History</h5>
                        <t t-set="visits" t-value="doc.env['hr_hospital.visit'].search(
                            [('doctor_id', '=', doc.id)],
                            order='planned_datetime desc'
                        )"/>
                        <t t-if="visits">
                            <table class="table table-sm table-bordered mb-4">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date &amp; Time</th>
                                        <th>Patient</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="visits" t-as="visit">
                                        <tr>
                                            <td>
                                                <t t-esc="visit.planned_datetime"/>
                                            </td>
                                            <td>
                                                <t t-esc="visit.patient_id.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="visit.visit_type"/>
                                            </td>
                                            <td>
                                                <t t-esc="visit.status"/>
                                            </td>
                                            <td>
                                                <t t-esc="visit.notes or ''"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No visits found.</p>
                        </t>

                        <h5 class="mt-4">Patients</h5>
                        <t t-set="patients" t-value="doc.env['hr_hospital.patient'].search(
                            [('personal_doctor_id', '=', doc.id)]
                        )"/>
                        <t t-if="patients">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Full Name</th>
                                        <th>Gender</th>
                                        <th>Birth Date</th>
                                        <th>Phone</th>
                                        <th>Visit Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="patients" t-as="patient">
                                        <t t-set="last_visit" t-value="doc.env['hr_hospital.visit'].search(
                                            [('patient_id', '=', patient.id),
                                             ('doctor_id', '=', doc.id)],
                                            order='planned_datetime desc',
                                            limit=1
                                        )"/>
                                        <tr>
                                            <td>
                                                <t t-esc="patient.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="patient.gender or ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="patient.birth_date"/>
                                            </td>
                                            <td>
                                                <t t-esc="patient.phone or ''"/>
                                            </td>
                                            <td t-if="last_visit and last_visit.status == 'planned'"
                                                style="background-color: #fff3cd; color: #856404;">
                                                Planned
                                            </td>
                                            <td t-elif="last_visit and last_visit.status == 'completed'"
                                                style="background-color: #d1e7dd; color: #0f5132;">
                                                Completed
                                            </td>
                                            <td t-elif="last_visit and last_visit.status == 'cancelled'"
                                                style="background-color: #f8d7da; color: #842029;">
                                                Cancelled
                                            </td>
                                            <td t-else="">
                                                —
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No patients assigned.</p>
                        </t>

                        <div class="footer" style="
                            border-top: 1px solid #dee2e6;
                            padding-top: 6px;
                            font-size: 11px;
                            color: #6c757d;
                        ">
                            <t t-set="company" t-value="doc.env.company"/>
                            <span>
                                Printed: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y %H:%M')"/>
                            </span>
                            <span class="ms-3">
                                City: <t t-esc="company.city or ''"/>
                            </span>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_doctor" model="ir.actions.report">
        <field name="name">Doctor Report</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_hospital.report_doctor_template</field>
        <field name="report_file">hr_hospital.report_doctor_template</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="hr_hospital.model_hr_hospital_doctor"/>
        <field name="binding_type">report</field>
    </record>
</odoo>